# GitHub Actions MCP Server Configuration
# Copy this file to config.yaml and fill in your values

# GitHub token
# Can also be set via:
#   - GITHUB_TOKEN environment variable
#   - macOS Keychain (automatic if you've run `gh auth login`)
# Leave empty or remove this line to use env var or keychain fallback
token: your_github_token_here

# Repository owner (e.g., "yourusername" or "yourorganization")
repo_owner: owner

# Repository name (e.g., "myrepo")
repo_name: repo

# Log level: debug, info, warn, error
log_level: info

# Optional result-shaping defaults. The values shown are the built-in defaults.
# Env vars: GITHUB_<NAME> / GH_<NAME>, e.g. GITHUB_PER_PAGE_LIMIT.
# default_limit: 10       # items a list tool returns when the caller does not say
# default_log_len: 100    # log lines returned when the caller does not say
# per_page_limit: 50      # GitHub API page size (GitHub caps this at 100)
# default_format: compact # result verbosity: minimal, compact, full

# Retry safe GitHub API reads after transient failures or rate limits.
# Set to -1 to disable retries. Env: GITHUB_RETRY_MAX / GH_RETRY_MAX
retry_max: 3

# Directory that download_artifact is allowed to write beneath.
# Env: GITHUB_ARTIFACT_ROOT / GH_ARTIFACT_ROOT
artifact_root: .

# Optional: route API calls through a GitHub Enterprise server or a reverse
# proxy such as gh-proxy. Must end with a trailing slash. When set, the token
# above should be the proxy's consumer token (not a GitHub PAT).
# Env vars: GITHUB_API_BASE_URL / GH_API_BASE_URL, GITHUB_UPLOAD_URL / GH_UPLOAD_URL
# api_base_url: http://gh-proxy:8080/api/
# upload_url: http://gh-proxy:8080/api/uploads/

# Optional: use HTTP Basic auth (username + token above) instead of a Bearer
# token. Required by some reverse proxies. A token written as "user.secret"
# alongside an api_base_url is split into these two automatically.
# Env vars: GITHUB_AUTH_USERNAME / GH_AUTH_USERNAME
# auth_username: my-proxy-user

# Optional: derive api_base_url and Basic-auth credentials automatically from
# git's url.<proxy>.insteadOf rewrite rules (gh-proxy). Enabled by default;
# ignored when api_base_url is set above.
# Env vars: GITHUB_GIT_PROXY_DETECT / GH_GIT_PROXY_DETECT
# git_proxy_detect: true
