  {
    "annotations": {
      "destructiveHint": false,
      "openWorldHint": true,
      "readOnlyHint": true
    },
    "description": "Get workflow run details. Start with element=info, then use jobs/logs/log_sections/artifacts as needed.",
    "inputSchema": {
      "properties": {
        "artifact_id": {
          "description": "For element=artifact_content: the artifact ID to get contents for",
          "type": "integer"
        },
        "attempt_number": {
          "description": "For element=jobs: attempt number for the jobs (default: latest)",
          "type": "integer"
        },
        "context": {
          "default": 0,
          "description": "For element=logs: number of lines to show before and after each search match (default: 0)",
          "type": "integer"
        },
        "element": {
          "default": "info",
          "description": "Element to retrieve: info (default), jobs, logs, log_files, log_sections, artifacts, artifact_content. Invalid values return a validation error with allowed options.",
          "enum": [
            "info",
            "jobs",
            "logs",
            "log_files",
            "log_sections",
            "artifacts",
            "artifact_content"
          ],
          "type": "string"
        },
        "file_pattern": {
          "description": "For element=logs or artifact_content: glob pattern to filter files (e.g., '*.log', 'build/*')",
          "type": "string"
        },
        "format": {
          "default": "compact",
          "description": "For element=info, jobs, artifacts, log_files: output format (compact/full, default: compact)",
          "type": "string"
        },
        "head": {
          "description": "For element=logs: return the first N lines of logs. Without head or tail, logs are auto-truncated to the last ~100 lines",
          "type": "integer"
        },
        "job_id": {
          "description": "For element=logs or element=log_sections: specific job ID to get logs/sections for",
          "type": "integer"
        },
        "max_file_size": {
          "default": 1048576,
          "description": "For element=artifact_content: maximum size of individual files to read in bytes (default: 1MB)",
          "type": "integer"
        },
        "no_headers": {
          "description": "For element=logs: don't print file headers (=== filename ===)",
          "type": "boolean"
        },
        "offset": {
          "description": "For element=logs: skip first N lines before returning (0-based)",
          "type": "integer"
        },
        "owner": {
          "description": "Optional: override repository owner for this call",
          "type": "string"
        },
        "per_job": {
          "description": "For element=logs: get logs per-job instead of all logs combined",
          "type": "boolean"
        },
        "repo": {
          "description": "Optional: override repository name for this call",
          "type": "string"
        },
        "run_id": {
          "description": "The workflow run ID",
          "type": "integer"
        },
        "search": {
          "description": "For element=logs: search/filter logs to lines containing this substring (case-insensitive)",
          "type": "string"
        },
        "search_regex": {
          "description": "For element=logs: filter logs to lines matching this regex pattern",
          "type": "string"
        },
        "section": {
          "description": "For element=logs: extract a specific section by name/pattern (e.g., 'Build', 'Test'). GitHub Actions sections are marked with ##[group]Section Name",
          "type": "string"
        },
        "tail": {
          "description": "For element=logs: return the last N lines of logs (default: auto-truncated to last ~100 lines if neither head nor tail is specified)",
          "type": "integer"
        }
      },
      "required": [
        "run_id"
      ],
      "type": "object"
    },
    "name": "get_run"
